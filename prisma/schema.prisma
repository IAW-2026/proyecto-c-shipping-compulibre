generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Internal admin user. Synced from Clerk on first login via JWT or webhook.
/// Only users with publicMetadata.roles = ["admin"] reach this app.
model AdminProfile {
  clerkUserId String    @unique @map("clerk_user_id")
  displayName String    @map("display_name")
  role        AdminRole @default(SUPERADMIN)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("admin_profiles")
}

/// A shipment record created by Payments App once a payment is confirmed.
/// The tracking_id is the primary key and the public-facing identifier
/// shared with Buyer App and Seller App via webhooks.
/// external_tracking_id is the courier's own reference, used to correlate
/// incoming status-change webhooks back to this record.
model Shipment {
  trackingId            String          @id @map("tracking_id")
  externalTrackingId    String          @unique @map("external_tracking_id")
  externalSellerOrderId String          @map("external_seller_order_id")
  externalBuyerId       String          @map("external_buyer_id") @default("")
  externalSellerId      String          @map("external_seller_id") @default("")
  courier               String
  originAddress         String          @map("origin_address")
  destinationAddress    String          @map("destination_address")
  status                ShipmentStatus  @default(LABEL_CREATED)
  labelUrl              String?         @map("label_url")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  events                ShipmentEvent[]

  @@index([status])
  @@index([externalSellerOrderId])
  @@map("shipments")
}

model ShipmentEvent {
  id           String         @id @default(cuid())
  trackingId   String         @map("tracking_id")
  statusUpdate ShipmentStatus @map("status_update")
  location     String?
  timestamp    DateTime       @default(now())
  shipment     Shipment       @relation(fields: [trackingId], references: [trackingId], onDelete: Cascade)

  @@index([trackingId])
  @@map("shipment_events")
}

enum AdminRole {
  SUPERADMIN
}

enum ShipmentStatus {
  LABEL_CREATED
  IN_TRANSIT
  DELIVERED
}
